# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

PVE_HOST=<hostname or IP of PVE host>
# One PBS-backed storage id, or several comma-separated (issue #43) - one
# per PBS namespace when a cluster backs up to more than one, e.g.
# PVE_STORAGE=pbs-prod,pbs-staging,pbs-lab
PVE_STORAGE=pbs
# Whether the portal verifies Proxmox's API cert (this is separate from
# the portal's own HTTPS cert below):
#   false          - don't verify (Proxmox's default cert is self-signed;
#                    the usual homelab setting)
#   true           - verify against the container's SYSTEM trust store
#                    (/etc/ssl/certs - so a CA you added with
#                    `update-ca-certificates` counts - plus SSL_CERT_FILE)
#   <path>         - verify against that CA file or directory
# Use `true` only if Proxmox itself serves a cert your CA issued.
PVE_VERIFY_SSL=false

# PH.4: per-user PVE ticket login replaces the old shared API tokens -
# there's no PVE_TOKEN_*/PBS_* config anymore. See docs/plan.md §7.1 for
# the admin steps to grant a user the FileRestoreReader role.

# Force logout after this many minutes of no activity, regardless of the
# underlying PVE ticket's own lifetime.
SESSION_IDLE_TIMEOUT_MINUTES=30

# HTTPS by default (docs/plan.md §7.3) - port 8008 follows PBS's own 8007.
# A self-signed cert is generated automatically at these paths on first
# run if they don't already exist; drop your own cert/key at the same
# paths to use a CA-issued one instead.
PORT=8008
TLS_CERT_FILE=certs/portal.crt
TLS_KEY_FILE=certs/portal.key

# Minimum seconds this app waits between the end of its own
# previous guest-agent command on a guest and the start of its next one
# (docs/plan.md §7.5) - so it doesn't monopolize the guest's single
# command-at-a-time channel, especially once a multi-chunk restore is
# sending many commands back to back. 0 (default) disables this; only
# worth raising if a restore is observed crowding out other guest-agent
# users (a scheduled PBS backup's fs-freeze, `qm agent` from the CLI).
GUEST_AGENT_MIN_COMMAND_GAP_SECONDS=0

# Direct Network Transfer (docs/plan.md §7.6, issue #22 - internally
# "Design C") - the data-plane NIC(s) its download endpoint may be
# served from, one entry per non-routable subnet a target guest might
# live in. Empty by default: never offered until an admin opts in here.
# JSON array of {"cidr", "local_ip", "hostname"?} objects. local_ip is
# THIS host's address on that segment (the guest connects to it), not
# the guest's. "hostname" (issue #47) is optional: a DNS name for that
# segment, used in the download URL and the cert SAN instead of the bare
# IP. If this host's IP changes, update local_ip and restart - the
# auto-generated data-plane cert re-issues itself for the new IP. E.g.
# RESTORE_DATA_NICS=[{"cidr":"10.0.5.0/24","local_ip":"10.0.5.5"},{"cidr":"10.0.6.0/24","local_ip":"10.0.6.5"}]
RESTORE_DATA_NICS=[]

# How long (seconds) a single-use Direct Network Transfer download link
# stays valid before it's treated as expired.
RESTORE_DOWNLOAD_TOKEN_TTL_SECONDS=120

# The port the Direct Network Transfer download URL points at, and that
# run.py binds the data listener(s) on. 0 (default) resolves to PORT+1 -
# a specific-IP listener can't share a port with the main 0.0.0.0 bind
# on most kernels. Set explicitly only if your setup allows sharing.
RESTORE_DATA_NIC_PORT=0

# Direct Network Transfer data-plane TLS (issue #47, docs/plan.md
# §7.6.1). PREFERRED is the strongest mode to attempt, MINIMUM the floor
# (must not be stricter than PREFERRED):
#   verify    - HTTPS, guest validates the data-plane cert
#   insecure  - HTTPS, encryption only, no validation
#   plaintext - HTTP, as before #47
# Per guest, the strongest mode in [MINIMUM, PREFERRED] the detected
# fetch tool can do is used (curl/wget/python/Invoke-WebRequest/cscript
# can skip-verify; certutil/bitsadmin can't; bash has no TLS). If none
# qualifies, ON_UNMET decides: `fallback` (chunked write over QMP - off
# the data network) or `fail`. When PREFERRED isn't plaintext the data
# listener is HTTPS, so a plaintext floor can't be served over it and is
# clamped up to `insecure`.
RESTORE_DATA_NIC_TLS_PREFERRED=verify
RESTORE_DATA_NIC_TLS_MINIMUM=insecure
RESTORE_DATA_NIC_TLS_ON_UNMET=fallback
RESTORE_DATA_NIC_TLS_MIN_VERSION=1.2
# Whether this app installs the data-plane CA into a target guest's
# trust store so `verify` works without you pre-provisioning it:
#   never      - the guest must already trust the cert (default)
#   if-missing - install only when it's not there yet
#   always     - install (idempotently) on every restore
# Needs the same VM.GuestAgent.Unrestricted grant DNT already requires.
RESTORE_DATA_NIC_TLS_INSTALL_CA=never
# Data-plane cert/key/CA. Auto-generated self-signed (IP SANs for every
# RESTORE_DATA_NICS entry, plus any per-NIC hostname) if cert+key are
# both absent; your own pair dropped at these paths is used as-is and
# never overwritten. CA file blank => the cert file itself.
RESTORE_DATA_NIC_TLS_CERT_FILE=certs/data-plane.crt
RESTORE_DATA_NIC_TLS_KEY_FILE=certs/data-plane.key
RESTORE_DATA_NIC_TLS_CA_FILE=

# Poll budget (seconds) for a guest-exec command whose duration scales
# with file size - Direct Network Transfer's actual fetch, or hashing/
# concatenating a large file. Confirmed live 2026-09-01 that the ~15s
# default used everywhere else (mkdir, an exists check - fine for those)
# isn't remotely enough for a real large-file transfer.
RESTORE_LONG_RUNNING_EXEC_TIMEOUT_SECONDS=1800

# Colour theme (issue #29) a browser gets before the user picks their
# own from the user menu (their choice is then remembered client-side).
# One of: auto | light | dark | proxmox-dark. "auto" follows the
# browser/OS setting but falls back to dark when the OS states no
# preference. "proxmox-dark" mirrors Proxmox VE's own dark theme.
DEFAULT_THEME=auto

# Directory for the app's own small, durable state (features that use it
# are still being built - issue #30). Defaults to "data" under the app
# dir. The systemd unit sets this to /var/lib/pve-flr-portal and
# docker-compose mounts a named volume at /app/data, so you normally
# only set this for a bare source checkout in an unusual location.
# PFR_DATA_DIR=data
