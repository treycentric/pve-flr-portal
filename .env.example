# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

PVE_HOST=titan.starrise.net
PVE_STORAGE=pbs
PVE_TOKEN_ID=pve-backup-portal@pve!portal
PVE_TOKEN_SECRET=
# Homelab self-signed cert: leave false until PVE serves a CA-trusted cert.
PVE_VERIFY_SSL=false

PBS_HOST=pbs.starrise.net
PBS_DATASTORE=pbs-iscsi
PBS_TOKEN_ID=pve-backup-portal@pbs!portal
PBS_TOKEN_SECRET=
PBS_VERIFY_SSL=false

# Phase 1 targets exactly one hardcoded guest; multi-guest support is PH.3.
GUEST_VMID=133
GUEST_TYPE=vm
