#!/usr/bin/env bash
# A stand-in for curl, for testing how deploy/lxc-create.sh fetches its library.
#   FAKE_LATEST_URL  what `releases/latest` redirects to (the -w %{url_effective} call)
#   FAKE_TAG_LIB     file served for a URL containing /v1.9.0/
#   FAKE_MAIN_LIB    file served for a URL containing /main/
#   FAKE_RAW_DIR     if set, instead serves FAKE_RAW_DIR/<ref>/<file name> (or fails)
case "$*" in
  *"-w"*) echo "${FAKE_LATEST_URL:-https://github.com/x/y/releases}"; exit 0 ;;
esac
url=""; out=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -*) shift ;;
    *) url="$1"; shift ;;
  esac
done
# FAKE_RAW_DIR/<ref>/<file name>, for tests that need different files per path
if [ -n "${FAKE_RAW_DIR:-}" ]; then
  ref=$(printf '%s' "$url" | sed -n 's|^https://raw.githubusercontent.com/[^/]*/[^/]*/\([^/]*\)/.*|\1|p')
  name="${url##*/}"
  # the path under deploy/ is tried first, so a test can serve either layout...
  rel=$(printf '%s' "$url" | sed -n 's|^.*/deploy/||p')
  if [ -n "$ref" ] && [ -n "$rel" ] && [ -f "$FAKE_RAW_DIR/$ref/deploy/$rel" ]; then
    cp "$FAKE_RAW_DIR/$ref/deploy/$rel" "$out"
    exit 0
  fi
  # ...then the bare file name, unless FAKE_RAW_STRICT is set
  if [ -z "${FAKE_RAW_STRICT:-}" ] && [ -n "$ref" ] && [ -f "$FAKE_RAW_DIR/$ref/$name" ]; then
    cp "$FAKE_RAW_DIR/$ref/$name" "$out"
    exit 0
  fi
  exit 22
fi
case "$url" in
  */v1.9.0/*) src="${FAKE_TAG_LIB:-}" ;;
  */main/*) src="${FAKE_MAIN_LIB:-}" ;;
  *) src="" ;;
esac
if [ -z "$src" ] || [ ! -f "$src" ]; then
  exit 22
fi
cp "$src" "$out"
