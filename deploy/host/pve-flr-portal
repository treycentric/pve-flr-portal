#!/usr/bin/env bash
# pve-flr-portal - manage the pve-flr-portal containers on this PVE node.
#
#   pve-flr-portal install                  create a new portal container
#   pve-flr-portal roles <command> [...]    create/inspect/delete the PVE roles
#   pve-flr-portal config [CTID]            change settings (portal and network)
#   pve-flr-portal update [CTID] [VERSION]  update (--all, -y, --snapshot: see --help)
#   pve-flr-portal status [CTID]            version, service state, address
#   pve-flr-portal host-tools [CTID]        install/update this command (GitHub, or a container)
#   pve-flr-portal list                     the containers it manages
#   pve-flr-portal adopt [CTID...]          start managing existing installs
#
# Installed as /usr/local/sbin/pve-flr-portal by deploy/lxc-create.sh, also
# linked as pve-flr-portal-config and pve-flr-portal-update. Run as root on the
# node that hosts the container.
#
# Containers are found by their Proxmox tag (pve-flr-portal), which the
# installer sets; `adopt` tags an install made before that. This is a thin
# stub on purpose: the real tools are copied out of the container's own
# checkout each time, so they always match the release that is installed.
set -euo pipefail

TAG="pve-flr-portal"
APP_DIR="/opt/pve-flr-portal"
TOOLS_DIR=""
# Where the host command and its links live (overridable for tests).
SBIN="${PFR_SBIN:-/usr/local/sbin}"

die() {
  echo "pve-flr-portal: $*" >&2
  exit 1
}

# Temp files/directories are removed when the command exits, however it
# exits (success, die, Ctrl-C, a failed command under set -e).
TMP_PATHS=()

# tmp_new VAR [mktemp args] - create one and store its path in VAR.
tmp_new() {
  local p
  p=$(mktemp "${@:2}")
  TMP_PATHS+=("$p")
  printf -v "$1" '%s' "$p"
}

cleanup() {
  if [ "${#TMP_PATHS[@]}" -gt 0 ]; then
    rm -rf "${TMP_PATHS[@]}"
  fi
}
trap cleanup EXIT

# note TEXT - a progress line, on stderr so scripted output stays clean.
note() {
  echo "$*" >&2
}

usage() {
  cat <<'EOF'
Usage: pve-flr-portal <command> [CTID] [arguments]

Commands:
  install                Create a new portal container: downloads the guided
                         installer from GitHub (the latest release, or
                         PFR_VERSION) and runs it. Repeat for more instances.
  roles <status|create|delete> [NAMES|--all] [options]
                         Create, inspect or delete the PVE roles the portal's
                         users need (FileRestoreReader, FileRestoreOperator,
                         FileRestoreReaderHost). Run `pve-flr-portal roles
                         --help` for the options.
  config [CTID]          Change the portal's settings and the container's
                         network configuration.
  update [CTID] [VERSION] [options]
                         Update to the latest release, or pin to VERSION
                         (e.g. v1.4.0, or main for unreleased work). Shows the
                         installed and new version first and asks to confirm.
                           --all          every running container on this node
                           -y, --yes      don't ask (needed without a terminal)
                           --snapshot     take a snapshot first (rollback point)
                           --no-snapshot  don't ask about a snapshot
                           --force        update even if already up to date
  status [CTID]          Show the installed version, service state and address.
  host-tools [CTID]      Install or update the host-side pieces (this command, its
                         -config/-update links, and the host-backup patch script
                         if installed). Downloads them from GitHub - the latest
                         release, or PFR_VERSION - so it works on a node with no
                         portal container; with a CTID, copies them from that
                         container's release instead.
  list                   List the containers managed from this node.
  adopt [CTID...]        Start managing existing installs: tag them so they
                         are found (with no CTID, scan the running containers).

With more than one container, you are asked which one (or pass its CTID).
Containers hosted on other cluster nodes have to be managed from those nodes.
EOF
}

have_tty() {
  [ -t 0 ] && [ -t 1 ]
}

# --- Finding containers ---------------------------------------------------

# ct_tags CTID -> its Proxmox tags, ";"-separated.
ct_tags() {
  pct config "$1" 2>/dev/null | sed -n 's/^tags: *//p'
}

has_tag() {
  case ";$(ct_tags "$1");" in
    *";$TAG;"*) return 0 ;;
  esac
  return 1
}

# ct_version CTID -> the installed version, "?" if it can't be read.
ct_version() {
  pct exec "$1" -- cat "$APP_DIR/VERSION" 2>/dev/null | head -1 || true
}

# list_rows - "id|name|status|version" for each tagged container on this node.
list_rows() {
  local id status name ver
  while read -r id status name; do
    if has_tag "$id"; then
      ver="?"
      if [ "$status" = "running" ]; then
        ver="$(ct_version "$id")"
        ver="${ver:-?}"
      fi
      echo "${id}|${name}|${status}|${ver}"
    fi
  done < <(pct list 2>/dev/null | awk 'NR>1{print $1, $2, $NF}')
}

# adopt_ct CTID - add the tag, keeping whatever tags it already has.
adopt_ct() {
  local existing
  existing="$(ct_tags "$1")"
  pct set "$1" --tags "${existing:+${existing};}${TAG}" >/dev/null
  echo "Now managing container $1."
}

# scan_candidates - running containers that have the portal but no tag.
scan_candidates() {
  local id status name
  while read -r id status name; do
    if [ "$status" = "running" ] && ! has_tag "$id" \
      && pct exec "$id" -- test -f "$APP_DIR/VERSION" 2>/dev/null; then
      echo "${id}|${name}"
    fi
  done < <(pct list 2>/dev/null | awk 'NR>1{print $1, $2, $NF}')
}

cmd_adopt() {
  local rows=() row id answer
  if [ "$#" -gt 0 ]; then
    for id in "$@"; do
      [[ "$id" =~ ^[0-9]+$ ]] || die "'$id' is not a container ID."
      pct exec "$id" -- test -f "$APP_DIR/VERSION" 2>/dev/null \
        || die "Container $id has no pve-flr-portal installation (or is not running)."
      adopt_ct "$id"
    done
    return 0
  fi
  while IFS= read -r row; do
    rows+=("$row")
  done < <(scan_candidates)
  if [ "${#rows[@]}" -eq 0 ]; then
    echo "No untagged running containers with a pve-flr-portal installation were found."
    return 0
  fi
  for row in "${rows[@]}"; do
    id="${row%%|*}"
    if have_tty; then
      read -rp "Manage container ${id} (${row#*|}) from here? [Y/n] " answer || answer="n"
      case "$answer" in
        n|N|no|NO) continue ;;
      esac
    fi
    adopt_ct "$id"
  done
}

# --- Choosing a container ------------------------------------------------

CTID=""

# choose_ct [EXPLICIT_CTID] - sets CTID.
choose_ct() {
  local explicit="${1:-}" rows=() row n i choice
  if [ -n "$explicit" ]; then
    pct config "$explicit" >/dev/null 2>&1 || die "Container $explicit was not found on this node."
    CTID="$explicit"
    return 0
  fi
  note "Looking for pve-flr-portal containers on this node - please wait..."
  while IFS= read -r row; do
    rows+=("$row")
  done < <(list_rows)
  if [ "${#rows[@]}" -eq 0 ]; then
    if have_tty && [ -n "$(scan_candidates | head -1)" ]; then
      echo "No containers are tagged '$TAG' yet, but existing installs were found."
      cmd_adopt
      while IFS= read -r row; do
        rows+=("$row")
      done < <(list_rows)
    fi
    if [ "${#rows[@]}" -eq 0 ]; then
      die "No pve-flr-portal containers found on this node (tag '$TAG'). Use 'pve-flr-portal adopt' for an existing install."
    fi
  fi
  if [ "${#rows[@]}" -eq 1 ]; then
    CTID="${rows[0]%%|*}"
    return 0
  fi
  have_tty || die "More than one container - give its CTID. $(printf '%s ' "${rows[@]%%|*}")"
  n=${#rows[@]}
  if command -v whiptail >/dev/null 2>&1; then
    local items=()
    for row in "${rows[@]}"; do
      IFS='|' read -r id name status ver <<< "$row"
      items+=("$id" "${name}  (${status}, v${ver#v})")
    done
    choice=$(whiptail --backtitle "pve-flr-portal" --title "Choose a container" \
      --menu "Which pve-flr-portal container?" $((n + 9)) 72 "$n" "${items[@]}" 3>&1 1>&2 2>&3) \
      || { echo "Cancelled."; exit 0; }
    CTID="$choice"
  else
    echo "Which pve-flr-portal container?"
    i=1
    for row in "${rows[@]}"; do
      IFS='|' read -r id name status ver <<< "$row"
      echo "  $i) CT $id  $name  ($status, v${ver#v})"
      i=$((i + 1))
    done
    read -rp "Number: " choice || exit 0
    [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$n" ] || die "Not a valid choice."
    CTID="${rows[$((choice - 1))]%%|*}"
  fi
}

ensure_running() {
  local status
  status=$(pct status "$1" | awk '{print $2}')
  if [ "$status" = "running" ]; then
    return 0
  fi
  have_tty || die "Container $1 is not running."
  read -rp "Container $1 is not running. Start it? [Y/n] " status || status="n"
  case "$status" in
    n|N|no|NO) exit 0 ;;
  esac
  pct start "$1"
  sleep 5
}

# --- Commands ------------------------------------------------------------

# pull_file CTID SRC DEST - copy a file out of the container. Fails, leaving
# DEST alone, if it isn't there or comes back empty: `pct pull` can report
# success and write an empty file for a missing source.
pull_file() {
  local tmp
  pct exec "$1" -- test -f "$2" 2>/dev/null || return 1
  tmp_new tmp
  if pct pull "$1" "$2" "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    cp "$tmp" "$3"
    rm -f "$tmp"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

fetch_tools() {
  note "Fetching the management tools from container $1 - please wait..."
  tmp_new TOOLS_DIR -d
  mkdir -p "$TOOLS_DIR/lib"
  if ! pull_file "$1" "$APP_DIR/deploy/pfr-manage.sh" "$TOOLS_DIR/pfr-manage.sh" \
    || ! pull_file "$1" "$APP_DIR/deploy/lib/settings.sh" "$TOOLS_DIR/lib/settings.sh"; then
    local ver
    ver="$(ct_version "$1")"
    die "Container $1 runs v${ver#v}, a release that predates the management tools (it has no deploy/pfr-manage.sh). Update it first: pve-flr-portal update $1 - and if it still lacks them afterwards, no release includes them yet."
  fi
}

cmd_config() {
  choose_ct "${1:-}"
  ensure_running "$CTID"
  fetch_tools "$CTID"
  bash "$TOOLS_DIR/pfr-manage.sh" config "$CTID"
}

# --- Versions and the host-side pieces ------------------------------------

# norm VERSION -> VERSION without a leading "v".
norm() {
  printf '%s' "${1#v}"
}

# latest_release CTID -> the newest vX.Y.Z tag on the container's origin
# (empty when it can't be read).
latest_release() {
  pct exec "$1" -- git -C "$APP_DIR" ls-remote --tags --refs origin 'v*.*.*' 2>/dev/null \
    | sed 's|.*refs/tags/||' | sort -V | tail -1 || true
}

# repo_url CTID -> the container's origin as an https GitHub URL (no .git).
repo_url() {
  local url
  url=$(pct exec "$1" -- git -C "$APP_DIR" remote get-url origin 2>/dev/null | head -1 || true)
  url="${url%.git}"
  case "$url" in
    https://github.com/*) echo "$url" ;;
  esac
}

# install_from_container CTID REL DEST - copy deploy/REL out of the
# container's checkout to DEST, only if it differs. The replacement is atomic
# (a new file moved over the old), so a copy that is running right now is
# unaffected. A release that doesn't have the file is skipped.
# install_file TMP DEST LABEL [MARKER] - put TMP at DEST, only if it differs.
# TMP must parse as a script (and contain MARKER, when given), or nothing is
# installed. The replacement is atomic (a new file moved over the old), so a
# copy that is running right now is unaffected.
install_file() {
  local tmp="$1" dest="$2" label="$3" marker="${4:-}"
  if ! bash -n "$tmp" 2>/dev/null || { [ -n "$marker" ] && ! grep -q "$marker" "$tmp"; }; then
    echo "Not updating $dest: the copy from $label isn't the expected script." >&2
    return 0
  fi
  if ! cmp -s "$tmp" "$dest" 2>/dev/null; then
    install -m 755 "$tmp" "$dest.new"
    mv -f "$dest.new" "$dest"
    echo "Updated $dest"
  elif [ "${VERBOSE_REFRESH:-0}" = "1" ]; then
    echo "Already up to date: $dest"
  fi
}

# install_from_container CTID REL DEST [MARKER] - copy deploy/REL out of the
# container's checkout. A release that doesn't have the file is skipped.
install_from_container() {
  local ctid="$1" rel="$2" dest="$3" marker="${4:-}" tmp
  tmp_new tmp
  if ! pull_file "$ctid" "$APP_DIR/deploy/$rel" "$tmp"; then
    return 0
  fi
  install_file "$tmp" "$dest" "container $ctid" "$marker"
}

# refresh_host_pieces CTID - bring what lives on the host in line with the
# release the container just moved to: this command (and its -config/-update
# links) and, if it was ever installed, the host-backup patch script that the
# apt hook runs.
# What a download from the network must contain to be taken for this command.
STUB_MARKER='^TAG="pve-flr-portal"'

# link_host_command - the -config / -update names for this command.
link_host_command() {
  if [ -f "$SBIN/pve-flr-portal" ]; then
    ln -sf pve-flr-portal "$SBIN/pve-flr-portal-config"
    ln -sf pve-flr-portal "$SBIN/pve-flr-portal-update"
  fi
}

# refresh_host_pieces CTID - bring what lives on the host in line with the
# release the container just moved to: this command (and its -config/-update
# links) and, if it was ever installed, the host-backup patch script that the
# apt hook runs.
refresh_host_pieces() {
  local ctid="$1"
  install_from_container "$ctid" host/pve-flr-portal "$SBIN/pve-flr-portal"
  link_host_command
  if [ -f "$SBIN/pve-flr-portal-patch-host-backups.sh" ]; then
    install_from_container "$ctid" patch-pve-host-backups.sh "$SBIN/pve-flr-portal-patch-host-backups.sh"
  fi
}

# github_refs - the refs to try, in order: PFR_VERSION (a tag or branch) if
# set, else the latest release; then main (a release can predate the file).
github_refs() {
  local slug tag
  slug="$(github_slug)"
  tag="${PFR_VERSION:-}"
  if [ -z "$tag" ]; then
    tag=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/${slug}/releases/latest" 2>/dev/null || true)
    tag="${tag##*/}"
    case "$tag" in
      v[0-9]*) ;;
      *) tag="" ;;
    esac
  fi
  if [ -n "$tag" ]; then
    echo "$tag"
  fi
  echo main
}

# github_slug - owner/repo from REPO_URL (a GitHub URL).
github_slug() {
  local url="${REPO_URL:-https://github.com/treycentric/pve-flr-portal.git}" slug
  case "$url" in
    https://github.com/*) ;;
    *) die "REPO_URL must be a GitHub URL." ;;
  esac
  slug="${url#https://github.com/}"
  echo "${slug%.git}"
}

# refresh_from_github - for a node with no container to copy from: download
# the host command (and the host-backup patch script, if installed) from the
# first ref that has the command.
refresh_from_github() {
  local slug ref tmp raw
  slug="$(github_slug)"
  for ref in $(github_refs); do
    raw="https://raw.githubusercontent.com/${slug}/${ref}/deploy"
    tmp_new tmp
    if curl -fsSL "$raw/host/pve-flr-portal" -o "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
      echo "Downloaded from $ref."
      install_file "$tmp" "$SBIN/pve-flr-portal" "GitHub ($ref)" "$STUB_MARKER"
      link_host_command
      if [ -f "$SBIN/pve-flr-portal-patch-host-backups.sh" ]; then
        tmp_new tmp
        if curl -fsSL "$raw/patch-pve-host-backups.sh" -o "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
          install_file "$tmp" "$SBIN/pve-flr-portal-patch-host-backups.sh" "GitHub ($ref)"
        fi
      fi
      return 0
    fi
  done
  die "Could not download the host command from GitHub. Check the network, or give a container ID to copy it from that container's checkout."
}

# --- Commands ---------------------------------------------------------------

ASSUME_YES=0
SNAPSHOT_MODE="ask"
FORCE=0

# ask_yes TEXT - [Y/n]; the answer is yes without a terminal's say-so only
# when -y was given (checked by the callers).
ask_yes() {
  local answer
  read -rp "$1 [Y/n] " answer || answer="n"
  case "$answer" in
    n|N|no|NO) return 1 ;;
  esac
  return 0
}

# manual_update_help CTID TARGET LATEST - a container installed before
# update.sh existed can't update itself that way. install.sh keeps its .env
# and reinstalls dependencies, the systemd unit and the service, so checking
# out the release and running it is the manual equivalent.
# legacy_checkout TARGET LATEST - the git command that selects the release.
legacy_checkout() {
  case "$1" in
    main) echo "git checkout --quiet main && git merge --quiet --ff-only origin/main" ;;
    ""|latest)
      if [ -n "$2" ]; then
        echo "git checkout --quiet $2"
      else
        echo 'git checkout --quiet "$(git tag -l "v*.*.*" --sort=-v:refname | head -1)"'
      fi
      ;;
    *) echo "git checkout --quiet v$(norm "$1")" ;;
  esac
}

# legacy_script TARGET LATEST - what update.sh would do for a container that
# predates it: fetch, check out the release, run install.sh (which keeps .env
# and reinstalls dependencies, the systemd unit and restarts the service).
# certbot isn't installed - an update doesn't add packages the install lacked.
legacy_script() {
  cat <<EOF
set -e
cd $APP_DIR
git config --system --add safe.directory $APP_DIR
if [ -n "\$(git status --porcelain)" ]; then
  echo "The install directory has local changes - check 'git status' in $APP_DIR first." >&2
  exit 1
fi
git fetch --quiet --tags origin
$(legacy_checkout "$1" "$2")
INSTALL_CERTBOT=0 bash deploy/install.sh
EOF
}

# legacy_possible CTID - is the container a git checkout with install.sh,
# and does it have git? Then the steps above can be run for the person.
legacy_possible() {
  pct exec "$1" -- test -d "$APP_DIR/.git" 2>/dev/null \
    && pct exec "$1" -- test -f "$APP_DIR/deploy/install.sh" 2>/dev/null \
    && pct exec "$1" -- sh -c 'command -v git >/dev/null 2>&1' 2>/dev/null
}

# manual_update_help CTID TARGET LATEST - for an install that predates
# update.sh and can't be updated for the person (no git checkout, ...).
manual_update_help() {
  local ctid="$1" name version
  name=$(pct config "$ctid" | sed -n 's/^hostname: *//p')
  version="$(ct_version "$ctid")"
  cat >&2 <<EOF
Container $ctid ($name) was installed before update.sh existed (it runs v${version#v}), and it
isn't a git checkout this command can update for you. Update it by hand - its
.env is kept, and afterwards 'pve-flr-portal update' works normally:

  pct exec $ctid -- bash -c 'git config --system --add safe.directory $APP_DIR && cd $APP_DIR && git fetch --tags origin && $(legacy_checkout "$2" "$3") && INSTALL_CERTBOT=0 bash deploy/install.sh'

EOF
}

# update_one CTID TARGET -> 0 updated, 10 already up to date, 11 declined,
# anything else failed. TARGET is empty/latest, main, or a version.
update_one() {
  local ctid="$1" target="$2" name current latest want url snapshot="" take=0 legacy=0 rc=0 args=()
  name=$(pct config "$ctid" | sed -n 's/^hostname: *//p')
  current="$(norm "$(ct_version "$ctid")")"
  latest="$(latest_release "$ctid")"
  case "$target" in
    ""|latest) want="$latest" ;;
    main) want="main" ;;
    *) want="v$(norm "$target")" ;;
  esac
  if [ -z "$target" ] || [ "$target" = "latest" ]; then
    if [ -n "$latest" ] && [ "$(norm "$latest")" = "$current" ] && [ "$FORCE" != "1" ]; then
      echo "Container $ctid ($name) is up to date (v$current)."
      return 10
    fi
  fi
  url="$(repo_url "$ctid")"
  echo "Container $ctid ($name): v${current:-?} -> ${want:-the latest release}"
  if [ -n "$url" ] && [ "${want:0:1}" = "v" ]; then
    echo "  Release notes: $url/releases/tag/$want"
  fi
  if [ "$target" = "main" ]; then
    echo "  (unreleased work from main - not a tested release)"
  fi
  # Checked before anything is asked or snapshotted.
  if ! pct exec "$ctid" -- test -f "$APP_DIR/deploy/update.sh" 2>/dev/null; then
    if legacy_possible "$ctid"; then
      legacy=1
      echo "  (installed before update.sh existed: the equivalent steps are run - fetch, check out the"
      echo "   release, install.sh - and .env is kept)"
    else
      manual_update_help "$ctid" "$target" "$latest"
      return 12
    fi
  fi
  if [ "$ASSUME_YES" != "1" ]; then
    have_tty || die "Updating without a terminal needs -y."
    ask_yes "Update container $ctid?" || return 11
  fi

  case "$SNAPSHOT_MODE" in
    yes) take=1 ;;
    ask)
      if have_tty && [ "$ASSUME_YES" != "1" ] && ask_yes "Take a snapshot first, so it can be rolled back?"; then
        take=1
      fi
      ;;
  esac
  if [ "$take" = "1" ]; then
    snapshot="pfr-pre-update-$(date +%Y%m%d-%H%M%S)"
    if pct snapshot "$ctid" "$snapshot" --description "Before the pve-flr-portal update to ${want:-latest}" >/dev/null 2>&1; then
      echo "Snapshot $snapshot taken (remove it later with: pct delsnapshot $ctid $snapshot)"
    else
      echo "Could not take a snapshot (does the container's storage support them?)." >&2
      snapshot=""
      if have_tty && [ "$ASSUME_YES" != "1" ]; then
        ask_yes "Update without one?" || return 11
      fi
    fi
  fi

  if [ -n "$target" ] && [ "$target" != "latest" ]; then
    args=("$target")
  fi
  if [ "$legacy" = "1" ]; then
    pct exec "$ctid" -- bash -c "$(legacy_script "$target" "$latest")" || rc=$?
  else
    pct exec "$ctid" -- bash "$APP_DIR/deploy/update.sh" "${args[@]}" || rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    echo "The update failed in container $ctid." >&2
    if [ -n "$snapshot" ]; then
      echo "Roll back with: pct rollback $ctid $snapshot" >&2
    fi
    return 1
  fi
  echo "Container $ctid is now at v$(norm "$(ct_version "$ctid")")."
  # Pinning an older version must not pull the host's tools back with it.
  case "$target" in
    ""|latest|main) refresh_host_pieces "$ctid" ;;
  esac
  return 0
}

update_all() {
  local target="$1" rows=() row id status rc updated=0 current=0 failed=0 skipped=0
  while IFS= read -r row; do
    rows+=("$row")
  done < <(list_rows)
  [ "${#rows[@]}" -gt 0 ] || die "No pve-flr-portal containers found on this node."
  if [ "$ASSUME_YES" != "1" ]; then
    have_tty || die "Updating without a terminal needs -y."
    echo "Containers: $(printf '%s ' "${rows[@]%%|*}")"
    ask_yes "Update all of them?" || exit 0
    if [ "$SNAPSHOT_MODE" = "ask" ]; then
      if ask_yes "Take a snapshot of each first, so it can be rolled back?"; then
        SNAPSHOT_MODE="yes"
      else
        SNAPSHOT_MODE="no"
      fi
    fi
    ASSUME_YES=1
  fi
  for row in "${rows[@]}"; do
    IFS='|' read -r id _ status _ <<< "$row"
    if [ "$status" != "running" ]; then
      echo "Skipping container $id (not running)."
      skipped=$((skipped + 1))
      continue
    fi
    rc=0
    update_one "$id" "$target" || rc=$?
    case "$rc" in
      0) updated=$((updated + 1)) ;;
      10) current=$((current + 1)) ;;
      *) failed=$((failed + 1)) ;;
    esac
  done
  echo
  echo "Updated: $updated, already up to date: $current, skipped: $skipped, failed: $failed."
  [ "$failed" -eq 0 ]
}

cmd_update() {
  local explicit="" target="" all=0 rc=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -y|--yes) ASSUME_YES=1 ;;
      --all) all=1 ;;
      --snapshot) SNAPSHOT_MODE="yes" ;;
      --no-snapshot) SNAPSHOT_MODE="no" ;;
      --force) FORCE=1 ;;
      -*) die "Unknown option $1 (see --help)." ;;
      *)
        if [[ "$1" =~ ^[0-9]+$ ]] && [ -z "$explicit" ] && [ -z "$target" ]; then
          explicit="$1"
        elif [ -z "$target" ]; then
          target="$1"
        else
          die "Too many arguments (see --help)."
        fi
        ;;
    esac
    shift
  done
  if [ "$all" = "1" ]; then
    [ -z "$explicit" ] || die "--all and a container ID don't go together."
    update_all "$target"
    return
  fi
  choose_ct "$explicit"
  ensure_running "$CTID"
  update_one "$CTID" "$target" || rc=$?
  case "$rc" in
    0|10) return 0 ;;
    11) echo "Cancelled."; return 0 ;;
    *) return "$rc" ;;
  esac
}

# host-tools [CTID] - install or update the host-side pieces from a
# container's checkout, without touching the container.
# host-tools [CTID] - install or update the host-side pieces without touching
# any container: from GitHub (the latest release; PFR_VERSION picks another),
# which works on a node that runs no portal container, or from the checkout
# of the container CTID.
cmd_host_tools() {
  VERBOSE_REFRESH=1
  if [ "$#" -eq 0 ]; then
    refresh_from_github
    echo "The host tools are up to date."
    return 0
  fi
  [[ "$1" =~ ^[0-9]+$ ]] || die "'$1' is not a container ID (see --help)."
  choose_ct "$1"
  ensure_running "$CTID"
  if ! pct exec "$CTID" -- test -f "$APP_DIR/deploy/host/pve-flr-portal" 2>/dev/null; then
    die "Container $CTID runs a release that doesn't include the host command. Update it first: pve-flr-portal update $CTID"
  fi
  refresh_host_pieces "$CTID"
  echo "The host tools match container $CTID's release."
}

# download_deploy_file REL VAR [MARKER] - fetch deploy/REL from the first ref
# that has it (see github_refs), as a script that parses and, if MARKER is
# given, contains it. Sets VAR to the temp file and GOT_REF to the ref.
GOT_REF=""
download_deploy_file() {
  local rel="$1" var="$2" marker="${3:-}" slug ref tmp
  slug="$(github_slug)"
  for ref in $(github_refs); do
    tmp_new tmp
    if curl -fsSL "https://raw.githubusercontent.com/${slug}/${ref}/deploy/$rel" -o "$tmp" 2>/dev/null \
      && [ -s "$tmp" ] && bash -n "$tmp" 2>/dev/null \
      && { [ -z "$marker" ] || grep -q "$marker" "$tmp"; }; then
      GOT_REF="$ref"
      printf -v "$var" '%s' "$tmp"
      return 0
    fi
  done
  return 1
}

# install [ARGS] - create a new portal container: download the installer
# (lxc-create.sh) from GitHub the same way host-tools does - the latest
# release, PFR_VERSION, or main - and run it here, at this terminal.
cmd_install() {
  local script
  note "Fetching the installer from GitHub - please wait..."
  download_deploy_file lxc-create.sh script '^PFR_LIB_API_WANTED=' \
    || die "Could not download the installer from GitHub. Check the network."
  echo "Using the installer from $GOT_REF." >&2
  bash "$script" "$@"
}

# roles [ARGS] - create, inspect or delete the PVE roles the portal's users
# need. The tool comes from GitHub the way `install` does; it runs on this
# node (roles are cluster-wide).
cmd_roles() {
  local script
  note "Fetching the roles tool from GitHub - please wait..."
  download_deploy_file pfr-roles.sh script '^PFR_ROLES_SCRIPT=1' \
    || die "Could not download the roles tool from GitHub. Check the network."
  echo "Using the roles tool from $GOT_REF." >&2
  bash "$script" "$@"
}

cmd_status() {
  local ver state ip latest
  choose_ct "${1:-}"
  ensure_running "$CTID"
  ver="$(ct_version "$CTID")"
  state="$(pct exec "$CTID" -- systemctl is-active pve-flr-portal 2>/dev/null || true)"
  ip="$(pct exec "$CTID" -- hostname -I 2>/dev/null | awk '{print $1}' || true)"
  echo "Container: $CTID ($(pct config "$CTID" | sed -n 's/^hostname: *//p'))"
  echo "Version:   ${ver:-unknown}"
  echo "Service:   ${state:-unknown}"
  latest="$(latest_release "$CTID")"
  if [ -z "$latest" ]; then
    echo "Latest:    unknown (couldn't reach the repository)"
  elif [ "$(norm "$latest")" = "$(norm "$ver")" ]; then
    echo "Latest:    $latest (up to date)"
  else
    echo "Latest:    $latest - update with: pve-flr-portal update $CTID"
  fi
  if [ -n "$ip" ]; then
    echo "Address:   $ip"
  fi
}

cmd_list() {
  local row id name status ver
  note "Looking for pve-flr-portal containers on this node - please wait..."
  printf '%-6s %-24s %-9s %s\n' "CTID" "NAME" "STATUS" "VERSION"
  while IFS= read -r row; do
    IFS='|' read -r id name status ver <<< "$row"
    printf '%-6s %-24s %-9s %s\n' "$id" "$name" "$status" "$ver"
  done < <(list_rows)
}

main() {
  local sub="" invoked
  invoked="$(basename "$0")"
  case "$invoked" in
    pve-flr-portal-config) sub="config" ;;
    pve-flr-portal-update) sub="update" ;;
    *) sub="${1:-}"; [ "$#" -gt 0 ] && shift ;;
  esac
  case "$sub" in
    ""|-h|--help|help) usage; exit 0 ;;
  esac
  command -v pct >/dev/null 2>&1 || die "pct not found - run this on the PVE host."
  case "$sub" in
    config) cmd_config "$@" ;;
    update) cmd_update "$@" ;;
    status) cmd_status "$@" ;;
    host-tools) cmd_host_tools "$@" ;;
    install) cmd_install "$@" ;;
    roles) cmd_roles "$@" ;;
    list) cmd_list ;;
    adopt) cmd_adopt "$@" ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
