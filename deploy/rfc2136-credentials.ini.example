# TSIG credentials for certbot's dns-rfc2136 plugin (issue #52).
#
# Copy to /etc/letsencrypt/rfc2136-credentials.ini on the LXC/host,
# fill in real values, then:
#   chmod 600 /etc/letsencrypt/rfc2136-credentials.ini
# certbot refuses to run with a plugin credentials file that's group/
# world readable.

dns_rfc2136_server = <your DNS server's IP, e.g. 10.0.0.53>
dns_rfc2136_port = 53
dns_rfc2136_name = <TSIG key name, e.g. certbot-key.>
dns_rfc2136_secret = <TSIG key secret, base64>
dns_rfc2136_algorithm = HMAC-SHA512
